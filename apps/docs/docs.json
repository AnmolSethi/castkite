      },
      {
        "tab": "Agents",
        "groups": [
          {
            "group": "MCP",
            "pages": [
              "mcp/introduction",
              "mcp/setup",
              "mcp/tools",
              "mcp/examples"
            ]
          }
        ]
      },
      {
        "tab": "Add Castkite to your app",
        "groups": [
          {
            "group": "OAuth2",
            "pages": [
              "oauth"
            ]
          }
        ]
      },
      {
        "tab": "Contributing",
        "groups": [
          {
            "group": "Development",
            "pages": [
              "contributing/developer-guide",
              "contributing/create-provider"
