{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Castkite Docs",
  "colors": {
    "primary": "#111111",
    "light": "#ffd400",
    "dark": "#111111"
  },
  "favicon": "/favicon.ico",
  "redirects": [
    {
      "source": "/public-api/oauth",
      "destination": "/oauth",
      "permanent": true
    },
    {
      "source": "/introduction",
      "destination": "/general/introduction",
      "permanent": true
    },
    {
      "source": "/quickstart",
      "destination": "/general/quickstart",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/general/support",
      "permanent": true
    },
    {
      "source": "/developer-guide",
      "destination": "/contributing/developer-guide",
      "permanent": true
    },
    {
      "source": "/configuration/create-provider",
      "destination": "/contributing/create-provider",
      "permanent": true
    },
    {
      "source": "/guide/:slug*",
      "destination": "/general/:slug*",
      "permanent": true
    },
    {
      "source": "/troubleshooting/:slug*",
      "destination": "/general/troubleshooting/:slug*",
      "permanent": true
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "general/introduction",
              "general/quickstart",
              "general/concepts",
              "general/where-things-live"
            ]
          },
          {
            "group": "Channels",
            "pages": [
              "general/channels/connect",
              "general/channels/manage",
              "general/channels/time-slots",
              "general/channels/customers"
            ]
          },
          {
            "group": "Creating posts",
            "pages": [
