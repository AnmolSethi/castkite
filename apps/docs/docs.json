    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/AnmolSethi/castkite",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Start scheduling",
      "href": "https://castkite.com/auth"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/AnmolSethi/castkite"
    }
  }
}
